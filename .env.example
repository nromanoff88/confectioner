# ==========================================
# Настройки бота MAX (business.max.ru)
# ==========================================
# Токен бота из business.max.ru -> Чат-боты -> Настройки
MAX_BOT_TOKEN=

# Публичное имя бота (username без @), к которому привязан Mini-App
MAX_BOT_NAME=confectioner_bot

# Список MAX User ID операторов (через запятую), которым разрешён доступ в Mini-App
# и которым приходят push-уведомления о новых сообщениях клиентов.
# Если пусто и включён DEV_MODE=true, пускает любого пользователя при локальной разработке.
OPERATOR_IDS=

# Режим получения обновлений: polling (для локальной разработки) или webhook (для продакшена)
MAX_UPDATE_MODE=polling
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=change_me_webhook_secret

# Путь к корневому сертификату Минцифры РФ (внутри Docker-контейнера уже предустановлен)
MAX_ROOT_CA_PATH=/etc/ssl/certs/russian_trusted_root_ca.pem

# ==========================================
# Режим разработки
# ==========================================
# При DEV_MODE=true можно открывать http://localhost:3000 в обычном браузере без MAX,
# также при первом запуске создаются демо-клиенты и примеры заказов с тортами.
DEV_MODE=true

# ==========================================
# База данных PostgreSQL
# ==========================================
POSTGRES_USER=confectioner
POSTGRES_PASSWORD=confectioner_secret
POSTGRES_DB=confectioner_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://confectioner:confectioner_secret@postgres:5432/confectioner_db?sslmode=disable

# ==========================================
# S3 Хранилище фотографий (MinIO или внешнее S3)
# ==========================================
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_BUCKET=confectioner-media
S3_USE_SSL=false
S3_REGION=us-east-1
# Если используется внешний облачный S3 (например, s3.twcstorage.ru или storage.yandexcloud.net),
# можно указать публичный префикс URL. По умолчанию фотографии раздаются через прокси бэкенда /api/media/...
S3_PUBLIC_URL=

# ==========================================
# Порты сервисов на хосте
# ==========================================
FRONTEND_PORT=3000
BACKEND_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

