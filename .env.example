# ==========================================
# Бот MAX (business.max.ru -> Чат-боты -> Настройки)
# ==========================================
MAX_BOT_TOKEN=
# Публичное имя бота (username без @), к которому привязано Mini-App
MAX_BOT_NAME=your_bot_name

# Регистрация кондитеров:
#   true  - любой, кто нажмёт «Старт» у бота, получает своё пространство (свои клиенты и заказы)
#   false - создавать пространство могут только пользователи из OPERATOR_IDS,
#           остальные могут войти лишь по ссылке-приглашению владельца
REGISTRATION_OPEN=true
OPERATOR_IDS=

# Часовой пояс для «сегодня/завтра» и напоминаний
APP_TIMEZONE=Asia/Yekaterinburg

MAX_UPDATE_MODE=polling
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=change_me_webhook_secret
MAX_ROOT_CA_PATH=/etc/ssl/certs/russian_trusted_root_ca.pem

# ВНИМАНИЕ: DEV_MODE=true отключает проверку подписи MAX и разрешает вход без MAX
# (?dev_user=ID). Только для локальной отладки, на сервере должно быть false.
DEV_MODE=false

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_USER=confectioner
POSTGRES_PASSWORD=change_me
POSTGRES_DB=confectioner_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://confectioner:change_me@postgres:5432/confectioner_db?sslmode=disable

# ==========================================
# S3 (MinIO или внешнее хранилище) — фото тортов
# ==========================================
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_BUCKET=confectioner
S3_USE_SSL=false
S3_REGION=us-east-1
S3_PUBLIC_URL=

FRONTEND_PORT=3000
BACKEND_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Домен для HTTPS (docker-compose.prod.yml, Caddy)
DOMAIN=84-201-128-158.sslip.io
